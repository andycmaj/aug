{
  "name": "@riker/root",
  "version": "0.0.2",
  "description": "Your first officer, in a terminal: triages GitHub and Slack, drafts your replies, and runs your crew of Claude agents, their tasks, projects and worktrees. Nothing goes out until you approve it. Built on OpenTUI Solid.",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "RIKER_DEV=1 bun packages/cli/script/riker.ts",
    "demo": "RIKER_FIXTURE=demo bun run --conditions=browser --preload @opentui/solid/preload ./packages/cli/src/riker.ts",
    "sim": "bun run --conditions=browser --preload @opentui/solid/preload ./packages/cli/src/riker.ts sim",
    "sim:do": "bun run ./packages/fixtures/src/sim/do.ts",
    "gen": "bun run ./packages/fixtures/src/gen/cli.ts",
    "debug": "RIKER_DEV=1 SHOW_CONSOLE=true bun run --inspect-wait --conditions=browser --preload @opentui/solid/preload ./packages/cli/src/riker.ts",
    "compile": "bun run packages/cli/script/compile.ts",
    "typecheck": "tsc --noEmit",
    "docs:keys": "bun run packages/tui/script/keys-doc.ts",
    "docs:screenshots": "bun run packages/tui/script/screenshots.ts",
    "docs:site": "bun run packages/tui/script/site.ts",
    "test": "bun test",
    "lint": "oxlint packages && oxfmt --check packages",
    "format": "oxlint --fix packages; oxfmt packages"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "25.2.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "5.9.3"
  }
}
